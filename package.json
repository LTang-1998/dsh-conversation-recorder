{
  "name": "dsh-conversation-recorder",
  "version": "2.0.0",
  "description": "DeepSeek Harness plugin: record every session into a readable _conversations/ Markdown chain.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LTang-1998/dsh-conversation-recorder.git"
  },
  "homepage": "https://github.com/LTang-1998/dsh-conversation-recorder#readme",
  "bugs": {
    "url": "https://github.com/LTang-1998/dsh-conversation-recorder/issues"
  },
  "author": "LTang-1998",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "conversation",
    "recorder",
    "session",
    "markdown"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "node node_modules/typescript/lib/tsc.js -p tsconfig.json --pretty false",
    "typecheck:client": "node node_modules/typescript/lib/tsc.js -p tsconfig.client.json --pretty false",
    "test": "node tests/run.ts",
    "verify": "pnpm build && git diff --exit-code -- lib",
    "verify:privacy": "node scripts/check-privacy.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
